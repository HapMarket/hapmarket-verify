{
  "name": "@hapmarket/verify",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Independently reproduce a HapMarket draw from chain data alone.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HapMarket/hapmarket-verify.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "hapmarket-verify": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src",
    "spec-public",
    "abi"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc",
    "check:spec": "node scripts/spec-public.ts check",
    "sync:spec": "node scripts/spec-public.ts sync",
    "check:deps": "node scripts/check-deps.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "typescript": "7.0.2"
  }
}
